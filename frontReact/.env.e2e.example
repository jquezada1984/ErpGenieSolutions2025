# Credenciales E2E (copiar a .env.e2e — no commitear secretos)
# frontReact/.env.e2e

# URL del front (Vite local o entorno QA). Por defecto http://localhost:3000
E2E_BASE_URL=http://localhost:3000

# Usuario de prueba (QA). Nunca usar prod / Supabase prod.
E2E_USER_EMAIL=
E2E_USER_PASSWORD=

# Alcance del usuario de prueba: GLOBAL | EMPRESA
# GLOBAL → se espera combo de empresa; EMPRESA → barra "Empresa de la sesión"
E2E_SCOPE=GLOBAL

# Opcional: 1 = ejecutar Grabar/Modificar en paneles, alertas, emails, seguridad
# Por defecto solo navega (happy-path estable)
E2E_MUTATE=0
